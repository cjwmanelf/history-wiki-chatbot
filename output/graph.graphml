      <data key="d8">한용운</data>
      <data key="d9">1938년부터는 중일전쟁, 태평양 전쟁에 반대하여 학도병 거부 운동을 벌였다.</data>
      <data key="d10">rule_participated_v4_doc_entity</data>
    </edge>
    <edge source="한인애국단" target="제1차 상하이 사변">
