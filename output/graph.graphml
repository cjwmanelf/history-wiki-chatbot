      <data key="d8">유길준</data>
      <data key="d9">분류: 갑신정변 (문서 '유길준' 의 위키 분류 행)</data>
      <data key="d10">rule_cat_participated_v6</data>
    </edge>
    <edge source="유동열" target="신민회">
      <data key="d5">FOUNDED</data>
      <data key="d6">rule</data>
      <data key="d7">0.88</data>
      <data key="d8">이동녕</data>
      <data key="d9">1907년 귀국하여 안창호(安昌浩) ·김구(金九) · 전덕기 · 양기탁 · 이동휘 · 이갑 · 유동열 등 동지들을 모아 신민회(新民會)를 조직하였다.</data>
      <data key="d10">rule_founded_v1_active</data>
