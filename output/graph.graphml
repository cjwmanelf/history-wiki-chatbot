    <edge source="신민회" target="국채보상운동">
      <data key="d5">PARTICIPATED_IN</data>
      <data key="d6">rule</data>
      <data key="d7">0.88</data>
      <data key="d8">신채호;유동열</data>
      <data key="d9">1907년에는 안창호가 주도하여 비밀리에 결성한 신민회에 가입하여 신민회 취지문을 작성하였으며, 국채보상운동에도 적극적으로 참여하였다.;1909년 8월 대한제국 참령(소령)으로 군대를 떠난 뒤에도 서우학회와 신민회, 서북학회에 관여하는 한편, 국채보상운동에도 참여했다.</data>
      <data key="d10">rule_participated_v1_active</data>
    </edge>
    <edge source="신익희" target="대한민국 임시정부">
